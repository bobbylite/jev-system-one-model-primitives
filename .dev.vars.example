# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# Production secret (not a var in wrangler.jsonc):
#   npx wrangler secret put TYPESAFE_API_KEY --name jev-primitives
#   npx wrangler secret put PINGONE_CLIENT_SECRET --name jev-primitives
# A missing TypeSafe key returns 503:
#   {"detail":"Jev is switched off until an API key is set."}
TYPESAFE_API_KEY=

# Local only. "true" uses the in-process PingOne stand-in and does not call PingOne.
# Ignored on the edge even if the var is set. Production wrangler.jsonc keeps this "false".
PINGONE_MOCK=true

# Local only. "true" returns canned Jev answers and does not call the network.
# Ignored on the edge even if the var is set. Leave unset once the key is real.
JEV_MOCK=true

# Optional local overrides. Defaults live in wrangler.jsonc ($2/day, 30/hour/IP).
# JEV_DAILY_BUDGET_USD=2
# JEV_IP_CALLS_PER_HOUR=30

# Optional. Send this exact value on authorize and on the token request.
# Leave blank unless the PingOne app has a redirect URI registered. See the README.
# PINGONE_REDIRECT_URI=https://jev-primitives.bobbylite.workers.dev/oauth/callback
